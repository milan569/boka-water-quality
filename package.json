{
  "name": "boka-water-quality-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP PWA map for sea water quality monitoring in Boka Kotorska using mock data.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:data": "node scripts/validate-data.mjs",
    "import:morsko": "node scripts/import-morsko-dobro.mjs",
    "update:weather": "node scripts/update-weather.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
